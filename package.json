{
  "name": "clinic-appointment-booking-api",
  "version": "1.0.0",
  "description": "Production-grade Clinic Appointment Booking API built with Next.js App Router and PostgreSQL, with strict double-booking concurrency guarantees.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:concurrency": "vitest run tests/concurrency.test.ts",
    "db:migrate": "npx tsx src/core/db/migrate.ts",
    "db:seed": "npx tsx src/core/db/seed.ts"
  },
  "keywords": [
    "clinic",
    "appointment-booking",
    "nextjs",
    "postgresql",
    "supabase",
    "concurrency",
    "row-level-locking",
    "vercel"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.8",
    "next": "^15.1.7",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
